# Cloudflare Worker를 배포한 공개 주소입니다. 비밀값이 아닙니다.
VITE_AUTH_API_BASE_URL=https://personal-homepage-admin-auth.YOUR-SUBDOMAIN.workers.dev

# 공개 사이트의 정규 URL과 GitHub Pages 하위 경로입니다. 로컬 개발에서는 비워 둡니다.
VITE_SITE_URL=https://YOUR-ACCOUNT.github.io/writer-first-homepage
VITE_BASE_PATH=/writer-first-homepage/

# 네이버 서치어드바이저에서 제공하는 소유 확인 코드입니다.
VITE_NAVER_SITE_VERIFICATION=
